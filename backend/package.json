{
  "name": "expenses-api",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node ./src/index.js",
    "dev": "nodemon ./src/index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "node ./scripts/seed.js",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && node ./scripts/seed.js",
    "storage:backfill": "node ./scripts/storage-backfill.js",
    "storage:verify": "node ./scripts/storage-verify.js",
    "storage:clear": "node ./scripts/storage-clear.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
